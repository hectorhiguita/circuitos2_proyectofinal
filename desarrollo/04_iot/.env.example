# =====================================================================
#  Medidor PPG - variables del servidor IoT
#  Copie este archivo a .env  (o ejecute scripts/generar_passwd.sh, que lo crea)
#  ¡NUNCA suba el archivo .env a git ni lo comparta!
# =====================================================================

# --- Usuario/grupo del host dueño de las carpetas montadas (Linux: `id -u` / `id -g`)
HOST_UID=1000
HOST_GID=1000
TZ=America/Bogota

# --- Exposición de puertos
# 1883 debe quedar en 0.0.0.0 para que el ESP32 de la LAN llegue al broker.
MQTT_BIND=0.0.0.0
# El editor/dashboard de Node-RED solo escucha en este PC. Para verlo desde el celular
# u otro PC de la LAN cambie a 0.0.0.0 (y active NODERED_ADMIN_* abajo).
NODERED_BIND=127.0.0.1

# --- MQTT (Mosquitto). Si deja las claves vacías, generar_passwd.sh crea claves aleatorias.
# El ESP32 (firmware 03_firmware) y el simulador usan el usuario "device".
MQTT_DEVICE_USER=medidor
MQTT_DEVICE_PASS=
# Node-RED usa este otro usuario.
MQTT_NODERED_USER=nodered
MQTT_NODERED_PASS=

# --- Dispositivo que muestra el dashboard (prefijo pulso/<DEVICE_ID>/)
DEVICE_ID=medidor01
# Umbrales por defecto (se publican como config retenida si el broker aún no tiene una)
BPM_MIN=50
BPM_MAX=120
# Enfriamiento entre alertas del mismo tipo, en segundos (SPEC: 5 min = 300)
ALERT_COOLDOWN_S=300

# --- Correo (Gmail con contraseña de aplicación; vea README)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Destinatarios separados por coma
EMAIL_TO=

# --- WhatsApp (CallMeBot; vea README). Para varios destinatarios use listas separadas
# por coma con el MISMO orden: CALLMEBOT_PHONE=+57300...,+57310...  CALLMEBOT_APIKEY=111,222
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# --- Registro CSV de la forma de onda (50 muestras/s, ~4 MB por hora). true/false
LOG_ONDA=false

# --- Opcional: proteger el editor y el dashboard si abre 1880 a la red.
# Hash bcrypt:  docker compose exec nodered node-red admin hash-pw
NODERED_ADMIN_USER=
NODERED_ADMIN_HASH=
DASHBOARD_USER=
DASHBOARD_HASH=
